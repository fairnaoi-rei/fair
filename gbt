<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Untuk Bintany</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Georgia', serif;
      background: linear-gradient(to right, #fce4ec, #f8bbd0);
      color: #6b1839;
      overflow: hidden;
    }

    .page {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      transition: opacity 1s ease, transform 1s ease;
      opacity: 0;
      transform: scale(0.95);
      pointer-events: none;
    }

    .page.active {
      opacity: 1;
      transform: scale(1);
      pointer-events: all;
    }

    .container {
      background: rgba(255, 255, 255, 0.85);
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 0 30px rgba(255, 182, 193, 0.5);
      max-width: 600px;
      z-index: 2;
    }

    h1 {
      font-size: 2.5em;
      margin-bottom: 20px;
      color: #c2185b;
    }

    p {
      font-size: 1.3em;
      line-height: 1.8;
    }

    button {
      margin-top: 20px;
      padding: 12px 25px;
      font-size: 1em;
      background-color: #f06292;
      color: white;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button:hover {
      background-color: #ec407a;
    }

    /* Efek kelopak bunga */
    .petal {
      position: fixed;
      width: 12px;
      height: 12px;
      background: rgba(240, 98, 146, 0.4);
      border-radius: 50%;
      animation: fall linear infinite;
      z-index: 1;
      pointer-events: none;
    }

    @keyframes fall {
      0% {
        transform: translateY(-10vh) translateX(0) rotate(0deg);
        opacity: 0;
      }
      20% {
        opacity: 1;
      }
      100% {
        transform: translateY(110vh) translateX(20px) rotate(360deg);
        opacity: 0;
      }
    }
  </style>
</head>
<body>

  <div class="page active" id="page0">
    <div class="container">
      <h1>Untukmu, Bintany</h1>
      <p>Dari seseorang yang ingin menyampaikan perasaan lewat kata.</p>
      <button onclick="nextPage()">Lanjut</button>
    </div>
  </div>

  <!-- Halaman romantis -->
  <div class="page" id="page1">
    <div class="container">
      <h1>Untukmu, Bintany</h1>
      <p id="romanticText"></p>
      <button onclick="nextMessage()">Selanjutnya</button>
    </div>
  </div>

  <!-- Halaman penutup -->
  <div class="page" id="page2">
    <div class="container">
      <h1>Terima Kasih, Bintany</h1>
      <p>Semoga kata-kata ini memberi kehangatan seperti halnya kehadiranmu yang diam-diam meneduhkan.</p>
    </div>
  </div>

  <audio id="bgMusic" loop autoplay>
    <source src="https://www.bensound.com/bensound-music/bensound-sweet.mp3" type="audio/mp3">
    Your browser does not support the audio element.
  </audio>

  <script>
    const pages = document.querySelectorAll('.page');
    let currentPage = 0;

    function nextPage() {
      if (currentPage < pages.length - 1) {
        pages[currentPage].classList.remove('active');
        currentPage++;
        pages[currentPage].classList.add('active');
      }
      if (currentPage === 1) showMessage(index); // mulai teks
    }

    const messages = [
      "Namamu adalah nada paling lembut dalam puisi hidupku.",
      "Keberadaanmu seperti embun pagi yang menenangkan jiwa.",
      "Ada kedamaian yang hanya hadir saat aku mengingatmu.",
      "Langit selalu terlihat lebih indah saat aku memikirkanmu.",
      "Senyap sekalipun terasa hangat saat ada bayanganmu di benakku.",
      "Jika waktu adalah bahasa, maka detik-detik bersamamu adalah doa yang tak henti.",
      "Setiap kata yang kutulis terasa lebih hidup saat terinspirasi olehmu.",
      "Tak perlu banyak suara, cukup kehadiranmu dan hatiku sudah mengerti.",
      "Namamu adalah satu-satunya kata yang tidak pernah lelah kugumamkan.",
      "Tanpa harus menyentuh, kamu telah menyentuh bagian terdalam dari diriku."
    ];

    let index = 0;
    const textEl = document.getElementById('romanticText');

    function showMessage(i) {
      textEl.textContent = messages[i];
    }

    function nextMessage() {
      index++;
      if (index < messages.length) {
        showMessage(index);
      } else {
        nextPage();
      }
    }

    // Kelopak bunga
    function generatePetals() {
      for (let i = 0; i < 40; i++) {
        const petal = document.createElement('div');
        petal.classList.add('petal');
        petal.style.left = Math.random() * 100 + 'vw';
        petal.style.animationDuration = (8 + Math.random() * 5) + 's';
        petal.style.animationDelay = Math.random() * 5 + 's';
        document.body.appendChild(petal);
      }
    }

    window.onload = () => {
      generatePetals();
    };
  </script>
</body>
</html>
